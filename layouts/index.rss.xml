{{- $pctx := . -}}
{{- if .IsHome -}}{{ $pctx = .Site }}{{- end -}}
{{- $pages := slice -}}
{{- if or $.IsHome $.IsSection -}}
    {{- if .Site.Params.nofeedSections -}}
        {{- $pages = where $pctx.RegularPages "Type" "not in" .Site.Params.nofeedSections -}}
    {{- else -}}
        {{- $pages = $pctx.RegularPages -}}
    {{- end -}}
{{- else -}}
    {{- if .Site.Params.nofeedSections -}}
        {{- $pages = where $pctx.Pages "Type" "not in" .Site.Params.nofeedSections -}}
    {{- else -}}
        {{- $pages = $pctx.Pages -}}
    {{- end -}}
{{- end -}}
{{- /* Drop nofeed pages before the limit: weighted dateless pages (e.g. /about/) otherwise
       waste item slots and poison lastBuildDate with a zero date */ -}}
{{- $pages = where $pages "Params.nofeed" "ne" true -}}
{{- $limit := .Site.Config.Services.RSS.Limit -}}
{{- if ge $limit 1 -}}
{{- $pages = $pages | first $limit -}}
{{- end -}}



{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
{{- printf "<?xml-stylesheet href=\"/pretty-feed-v3.xsl\" type=\"text/xsl\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:content="http://purl.org/rss/1.0/modules/content/" xmlns:media="http://search.yahoo.com/mrss/">
  <channel>
    <title>
        {{ if eq  .Title  .Site.Title }}
            {{ .Site.Title }}
        {{ else }}
            {{ with .Title }}
                {{.}} on 
            {{ end }}
            {{ .Site.Title }}
        {{ end }}
    </title>
    <link>{{ .Permalink }}</link>
    <description>
        Recent content 
        {{ if ne  .Title  .Site.Title }}
            {{ with .Title }}
                in {{.}} 
            {{ end }}
        {{ end }}
        on {{ $baseurl := urls.Parse .Site.BaseURL }}{{ $baseurl.Host }}
    </description>
    <generator>Hugo -- gohugo.io</generator>
    {{ with .Site.Language.Locale }}
    <language>{{.}}</language>{{end}}
    {{ with .Site.Params.author.email }}
    <managingEditor>{{.}}{{ with $.Site.Params.author.name }} ({{.}}){{end}}</managingEditor>
    {{end}}
    {{ with .Site.Params.author.email }}
    <webMaster>{{.}}{{ with $.Site.Params.author.name }} ({{.}}){{end}}</webMaster>
    {{end}}
    {{ with .Site.Copyright }}
    <copyright>{{ . | markdownify | plainify }}</copyright>
    {{end}}
    {{- /* lastBuildDate: use the newest item's date, not the section's creation date */}}
    {{- $lastBuild := .Date -}}
    {{- with $pages -}}{{- with index . 0 -}}{{- $lastBuild = .Date -}}{{- end -}}{{- end -}}
    {{ if not $lastBuild.IsZero }}
    <lastBuildDate>
        {{ $lastBuild.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}
    </lastBuildDate>
    {{ end }}
    {{- with .OutputFormats.Get "RSS" }}
        {{ printf "<atom:link href=%q rel=\"self\" type=%q />" .Permalink .MediaType | safeHTML }}
    {{- end }}
    {{- range $pages }}
            <item>
                <title>{{ .Title | htmlEscape }}</title>
                <link>
                    {{ .Permalink }}
                </link>
                <pubDate>
                    {{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}
                </pubDate>
                {{- with .Site.Params.author.email }}
                    <author>
                        {{.}}{{ with $.Site.Params.author.name }} ({{.}}){{end}}
                    </author>
                {{ end }}
                <guid>{{ .Permalink }}</guid>
                {{- $pagePermalink := .Permalink -}}
                {{- with .Params.images -}}
                    {{- $img := index . 0 -}}
                    {{- $imgPath := printf "%s%s" $pagePermalink $img -}}
                    {{- $mime := path.Ext $img | lower -}}
                    {{- $mimeType := "image/jpeg" -}}
                    {{- if eq $mime ".png" }}{{- $mimeType = "image/png" -}}{{- end -}}
                    {{- if eq $mime ".gif" }}{{- $mimeType = "image/gif" -}}{{- end -}}
                    {{- if eq $mime ".webp" }}{{- $mimeType = "image/webp" -}}{{- end -}}
                    {{- with resources.GetRemote $imgPath -}}
                        <enclosure url="{{ $imgPath }}" type="{{ $mimeType }}" length="{{ len .Content }}"></enclosure>
                    {{- end -}}
                {{ else -}}
                    {{- $images := .Resources.ByType "image" -}}
                    {{- $featured := $images.GetMatch "*feature*" -}}
                    {{- if not $featured }}{{ $featured = $images.GetMatch "{*cover*,*thumbnail*}" }}{{ end -}}
                    {{- with $featured -}}
                        {{- $mime := $featured.MediaType.SubType -}}
                        {{- $mimeType := "image/jpeg" -}}
                        {{- if eq $mime "png" }}{{- $mimeType = "image/png" -}}{{- end -}}
                        {{- if eq $mime "gif" }}{{- $mimeType = "image/gif" -}}{{- end -}}
                        {{- if eq $mime "webp" }}{{- $mimeType = "image/webp" -}}{{- end -}}
                        <enclosure url="{{ $featured.Permalink }}" type="{{ $mimeType }}" length="{{ len $featured.Content }}"></enclosure>
                    {{- end -}}
                    {{- /* No og.png fallback: that file does not exist and emitting length="0" breaks strict clients */}}
                {{- end }}

                {{- $images := union (.Resources.ByType "image") (.Resources.Match "**.{jpg,jpeg,png,gif,webp}") -}}
                {{- with $images }}
                    {{- range . }}
                        {{- $img := . }}
                        {{- $alt := or .Title .Name }}
                        {{- $caption := or .Params.caption "" }}
                        <media:content url="{{ .Permalink }}" medium="image" />
                    {{- end }}
                {{- end }}
                <description>
                    {{ printf "<![CDATA[" | safeHTML }}
                        {{- $content := replaceRE "a href=\"(#.*?)\"" (printf "%s%s%s" "a href=\"" .Permalink "$1\"") .Content -}}
                        {{- $content = replaceRE "img src=\"(.*?)\"" (printf "%s%s%s" "img src=\"" .Permalink "$1\"") $content -}}
                        {{ $content | safeHTML }}
                        
                        {{- $images := union (.Resources.ByType "image") (.Resources.Match "**.{jpg,jpeg,png,gif,webp}") -}}
                        {{- with $images }}
                            {{- range . }}
                                {{- $img := . }}
                                {{- $alt := or .Title .Name }}
                                {{- $caption := or .Params.caption "" }}
                                <figure>
                                    <img src="{{ .Permalink }}" 
                                         alt="{{ $alt }}"
                                         {{ if eq .MediaType.SubType "svg" }}
                                         {{else}}
                                         {{ with .Width }}width="{{ . }}"{{ end }}
                                         {{ with .Height }}height="{{ . }}"{{ end }}
                                         {{end}}
                                         loading="lazy" />
                                    {{ with $caption }}<figcaption>{{ . }}</figcaption>{{ end }}
                                </figure>
                            {{- end }}
                        {{- end }}
                        
                        <hr />
                        <p>Thank you for using RSS. I appreciate you. <a href="mailto:harper&#64;modest.com">Email me</a></p>
                        <img src="https://tinylytics.app/pixel/WV5Khk7ZG6MZe6q49ikx.gif" alt="" width="1" height="1" />
                    {{ printf "]]>" | safeHTML }}
                </description>
            </item>
    {{- end }}
  </channel>
</rss>
